amends "workbench:plan"

meta {
  title = "Replace context activation declarations with Pkl"
  goal = "One discoverable authored declaration and one activation resolver select contributors consistently across hooks, status and daemon admission, preserving bounded inactive and delivery behavior."
}

local design = new Action {
  id = "declaration-design"
  owner = "root"
  outcome = "Specify project/home authority, selection, composition, evaluator lifetime, freshness, migration and deletion of the JSON activation path."
  grant { "docs/context-declarations.md" }
  oracle = module.adjudicated("The proposal names defaults, scope boundaries, one resolver, exact evaluated-input capture, shared capacity protocol, effective-selection and descendant-preserving migration, explicit init outcomes, and separate product decisions versus feasibility questions; it does not claim unimplemented Pkl behavior is shipped.", "root")
}

local coldPolicy = new Selector {
  id = "cold-inactive-policy"
  owner = "Cole"
  question = "When a declaration exists but its snapshot is absent, may ultimately inactive hooks run a bounded temporary Pkl evaluator and publish private derived snapshots, or must they remain process/write-free?"
  options { "bounded-evaluation-and-private-snapshot"; "strict-inactive-redesign" }
}

local scopePolicy = new Selector {
  id = "scope-semantics"
  owner = "Cole"
  question = "Does the nearest project declaration completely own selection and block ancestor fallback, including directory-only descendants, or preserve ancestor refinement and coverage fallback?"
  options { "nearest-complete-boundary"; "ancestor-refinement" }
}

local baseline = new Guard {
  id = "existing-context-baseline"
  owner = "root"
  outcome = "Establish the final existing implementation revision and unresolved Fable review findings before overlapping production edits begin."
  observes { ".context/workbench-context/**"; "internal/context*/**"; "cmd/workbench/context*.go"; "acceptance/context_test.go" }
  oracle = module.adjudicated("Current implementation worker returned integrated verification and independent review dispositions; identify exact remaining defects, preserve honest evidence and release its write grants before Pkl production implementation.", "root")
}

local probe = new Action {
  id = "evaluation-probe"
  owner = "declaration-evaluation-worker"
  outcome = "Build and measure isolated evaluation: no-source inactivity versus home-only uncached inactivity, eight concurrent misses, nearly full shared cache, blocked version discovery/handshake, oversized output, exact dependency capture and joined cancellation under explicit resource budgets."
  grant { ".context/workbench-context-declaration/probe/**" }
  needs { module.produced(design) }
  oracle = module.mechanical("python3 .context/workbench-context-declaration/probe/run.py")
}

local feasibility = new Guard {
  id = "evaluation-feasibility"
  owner = "root"
  outcome = "Resolve the cold evaluation versus inactive-hook resource contract with measured evidence before committing consumers to an evaluator design."
  observes { "docs/context-declarations.md"; ".context/workbench-context-declaration/probe/**"; ".context/workbench-context/performance-evidence.md" }
  needs { module.produced(design); module.produced(probe); module.verified(probe); module.ruled(coldPolicy) }
  oracle = module.adjudicated("First verify the instrument matches Cole's recorded cold-inactive policy; timing cannot settle permission for evaluator startup or writes. Measure executable/version discovery through joined cleanup, explicit process/RAM/input/output/diagnostic limits, depth-12 inactive p95 <=30ms, warm p95 <=100ms and eight cold hooks <=2s. Test concurrent misses with trace publication and nearly full/reduced caps, bootstrap limits, reservations, cancellation and crash recovery. Capture exact evaluator-read bytes/import designations/targets and reject ABA or symlink retarget staleness. No hidden registry, stale fallback or unjoined handshake; conflicts require revised design and evidence.", "root")
}

local designReview = new Guard {
  id = "declaration-design-review"
  owner = "declaration-reviewer"
  outcome = "Review the concrete declaration proposal for understandable authority, compatible migration and faithful ADR value."
  observes { "docs/context-declarations.md"; "docs/adr/2026-09-wokbench-context.md" }
  needs { module.produced(design); module.verified(design); module.ruled(coldPolicy); module.ruled(scopePolicy) }
  oracle = module.adjudicated("Proposal and downstream graph match Cole's recorded scope and cold-inactive choices; alternative rulings require explicit revision, not automatic branch selection. Review home rules, no implicit builtin/profile-provider list, exact import input capture, shared capacity protocol, no JSON fallback, effective legacy selection and descendant-preserving conversion, and init outcomes that distinguish creation from effective activation.", "root")
}

local adoption = new Action {
  id = "reconcile-activation-adr"
  owner = "root"
  outcome = "Reconcile ADR activation/refinement and inactive runtime/write wording to actual product rulings before schema implementation."
  grant { "docs/adr/2026-09-wokbench-context.md" }
  needs { module.verified(designReview) }
  oracle = module.adjudicated("ADR and proposal state the same accepted scope and inactive semantics, including private snapshot writes; no later docs task is used to defer a current contradiction.", "root")
}

local contract = new Action {
  id = "declaration-contract"
  owner = "declaration-contract-worker"
  outcome = "Publish executable project/home Pkl schemas sharing typed selection plus canonical Go declaration/evaluation/load data contracts; settle exact URI and release embedding."
  grant { "pkl/WorkbenchContext*.pkl"; "pkl/context.go"; "WorkbenchContext*.pkl"; "internal/contextapi/config.go"; "internal/contextapi/declaration*_test.go"; ".context/workbench-context-declaration/contracts.md" }
  needs { module.verified(baseline); module.produced(adoption); module.verified(adoption); module.verified(feasibility) }
  oracle = module.adjudicated("Representative valid/invalid modules evaluate against bundled contracts. API agreement covers cancellation, exact reader-captured inputs/designations/targets, origin/digests, bootstrap limits, one cross-process capacity/reservation/publication/eviction/crash-recovery contract spanning snapshots and history, and a single replacement Load/Resolve seam. No placeholder implementation or JSON-presence domain semantics.", "root")
}

local evaluation = new Action {
  id = "bounded-evaluation"
  owner = "declaration-evaluation-worker"
  outcome = "Implement bounded local-import evaluation and disposable dependency-validated snapshots through the existing evaluator capability."
  grant { "internal/evaluate/context*.go"; "internal/evaluate/testdata/context/**" }
  needs { module.produced(contract); module.verified(contract) }
  oracle = module.mechanical("go test -race ./internal/evaluate")
}

local activation = new Action {
  id = "single-activation-resolver"
  owner = "declaration-activation-worker"
  outcome = "Replace JSON activation discovery/loading with Pkl canonical values and nearest complete selection; retain exactly one activation resolver and remove inherited contributor defaults."
  grant { "internal/contextconfig/**" }
  needs { module.produced(contract); module.verified(contract) }
  oracle = module.mechanical("go test -race ./internal/contextconfig")
}

local migration = new Action {
  id = "explicit-json-conversion"
  owner = "declaration-migration-worker"
  outcome = "Provide an explicit previewable JSON-to-Pkl converter preserving effective selection or refusing ambiguous inheritance, with no runtime fallback and no overwrite."
  grant { "internal/contextmigration/**" }
  needs { module.produced(contract); module.verified(contract) }
  oracle = module.mechanical("go test -race ./internal/contextmigration")
}

local acceptanceInstrument = new Action {
  id = "declaration-acceptance-instrument"
  owner = "declaration-acceptance-worker"
  outcome = "Author actual-binary acceptance cases and bounded measurement/native probe fixtures for the Pkl replacement before claiming delivery."
  grant { "acceptance/context_declaration_test.go"; "acceptance/testdata/context-declaration/**"; ".context/workbench-context-declaration/acceptance/**" }
  needs { module.produced(contract); module.verified(contract) }
  oracle = module.adjudicated("Instrument proves declaration origin, scope decisions, import edits/deletion/ABA/retargeting, same-length edits, old/new coexistence, generated/custom home paths, snapshot loss/shared capacity, effective legacy and descendant coverage, all init outcomes, provider/profile behavior and historical revisions through real CLI. Missing tests/build failures/timeouts cannot count as intended red behavior. Existing baseline fails Pkl activation witnesses for the intended reason.", "root")
}

local consumers = new Action {
  id = "activation-consumers-cutover"
  owner = "declaration-integration-worker"
  outcome = "Wire one loader into hooks/status/daemon; update init/conversion, reconcile generated versus custom home paths, enforce shared snapshot/trace capacity, and migrate existing JSON-oriented acceptance and peer tests without discarding their behavioral coverage."
  grant { "cmd/workbench/context*.go"; "internal/contextdaemon/**"; "internal/contexttrace/**"; "acceptance/context_test.go"; "internal/contextprovider/*_test.go"; "internal/contextengine/*_test.go"; "internal/contextapi/*_test.go" }
  needs { module.produced(evaluation); module.verified(evaluation); module.produced(activation); module.verified(activation); module.produced(migration); module.verified(migration); module.produced(acceptanceInstrument); module.verified(acceptanceInstrument) }
  oracle = module.mechanical("go test -race ./cmd/workbench ./internal/contextdaemon ./internal/contexttrace")
}

local documentation = new Action {
  id = "declaration-user-surface"
  owner = "declaration-docs-worker"
  outcome = "Replace JSON activation instructions/examples, reconcile ADR refinement language, and show explicit builtin/profile contributors, nested boundaries and migration in Pkl."
  grant { "docs/context.md"; "docs/context-declarations.md"; "docs/adr/2026-09-wokbench-context.md"; "examples/context/**" }
  needs { module.produced(contract); module.verified(contract); module.produced(consumers) }
  oracle = module.adjudicated("Examples evaluate using the published schema; init preserves existing Pkl expressions; status explains origin/coverage/capabilities and exclusions; no instructions keep JSON activation alive; contributor RPC JSON remains correctly documented. Schema and CLI errors help an ordinary agent diagnose missing guidance.", "root")
}

local integrated = new Guard {
  id = "declaration-public-proof"
  owner = "declaration-verifier"
  outcome = "Prove the Pkl path through real binary hook/setup/init/status/conversion/daemon behavior and dependency-change withdrawal."
  observes { "acceptance/context_declaration_test.go"; "acceptance/testdata/context-declaration/**"; "cmd/workbench/context*.go"; "internal/context*/**"; "internal/evaluate/context*.go" }
  needs { module.produced(consumers); module.verified(consumers); module.produced(documentation); module.verified(documentation); module.verified(acceptanceInstrument) }
  oracle = module.mechanical("go test ./acceptance -run Context -count=1 -timeout 180s")
}

local finalProof = new Guard {
  id = "declaration-completion"
  owner = "root"
  outcome = "Accept one authoritative Pkl declaration path with no remaining duplicate activation mechanism or hidden incomplete obligations."
  observes { "docs/context-declarations.md"; "docs/context.md"; "internal/context*/**"; "internal/evaluate/context*.go"; "cmd/workbench/context*.go"; ".context/workbench-context-declaration/**" }
  needs { module.verified(integrated); module.verified(feasibility); module.verified(documentation) }
  oracle = module.adjudicated("Independently inspect deletion of JSON runtime readers, nil/absent defaults and old path handling across all consumers. Full Go tests/vet/context race and platform builds pass on final revision. Measure accepted cold/warm/no-source and home-inactive budgets, exact cleanup and combined disk cap. Native Claude/Codex admission plus outcome-only declaration discovery/diagnosis use Pkl. Final proof accounts for migration, historical explainability and any open feasibility/user decisions; old JSON evidence is insufficient.", "root")
}

nodes {
  design; coldPolicy; scopePolicy; baseline; probe; feasibility; designReview; adoption; contract
  evaluation; activation; migration; acceptanceInstrument; consumers; documentation
  integrated; finalProof
}
