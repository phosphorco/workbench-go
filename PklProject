amends "pkl:Project"

local releaseCoordinate = "0.7.0"

package {
  // releaseCoordinate identifies the executable release/tag. The package
  // version below identifies the independent schema contract.
  name = "workbench"
  baseUri = "package://github.com/phosphorco/workbench-go/releases/download/\(releaseCoordinate)/workbench"
  version = "0.7.0"
  packageZipUrl =
    "https://github.com/phosphorco/workbench-go/releases/download/\(releaseCoordinate)/workbench@\(version).zip"

  exclude {
    "acceptance/**"
    ".github/**"
    "cmd/**"
    "distribution/**"
    "internal/**"
    "release/**"
    "README.md"
    "ROADMAP.md"
    "docs/**"
    "LICENSE"
    "go.mod"
    "go.sum"
    "mise.toml"
    "pkl-spike/**"
    "pkl/*.go"
    "examples/**"
    "skills/**"
  }
}
